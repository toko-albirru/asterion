{
  "name": "asterion",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "LINKS", "id": "GANTI_DENGAN_ID_KV_KAMU" }
  ]
}
