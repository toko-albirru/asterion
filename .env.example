# Browser (dipakai saat build)
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server (set di hosting sebagai secret; JANGAN dipublikasikan)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- Pembayaran ---
# promo    = token Pro gratis (default)
# mock     = QRIS palsu untuk tes alur (tombol "Simulasikan bayar")
# midtrans = QRIS sungguhan lewat Midtrans (alur lama)
# qris     = Premium 3 lisensi dengan QRIS statis GoPay Merchant, dikonfirmasi admin (alur baru)
PAYMENT_MODE=promo
# Samakan dengan PAYMENT_MODE: true bila mode bukan promo (hanya mengubah teks halaman depan)
VITE_PAYMENT_ENABLED=false
# Wajib bila PAYMENT_MODE=midtrans (Midtrans Dashboard > Settings > Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Unduhan aplikasi ---
# Alamat langsung ke file .exe (zip) yang diunggah ke GitHub Releases atau Cloudflare R2.
# Wajib bila file lebih dari 24 MB (hampir pasti, karena berisi Vina + Open Babel).
VITE_DOWNLOAD_URL=

# Opsional: email pemberitahuan ke institusi saat kupon habis terpakai (https://resend.com). Tanpa ini, hanya tampil di dashboard Institusi.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# --- Premium (PAYMENT_MODE=qris) ---
# String QRIS STATIS dari aplikasi GoPay Merchant (hasil scan QR-nya, diawali 000201...). Simpan sebagai secret.
QRIS_STATIC=
# Email admin SEMAR-Dock (pisahkan dengan koma). Wajib: aktifkan "Confirm email" di Supabase Auth.
ADMIN_EMAILS=
# Rahasia untuk menghash NIM & OTP (isi string acak panjang). Jika kosong, dipakai service role key, yang berarti
# memutar service role key akan mengubah semua hash NIM. Disarankan isi sendiri dan jangan diubah lagi.
NIM_HASH_SECRET=
# OTP email kampus memakai RESEND_API_KEY + NOTIFY_FROM_EMAIL di atas (gratis 100 email/hari di resend.com).
# Tanpa keduanya, verifikasi hanya lewat unggah KRS / surat keterangan dan selalu diperiksa admin.
